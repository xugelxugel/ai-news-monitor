data/briefings/
data/today_articles.json
data/analysis.json

# GitHub Pages 发布目录（云端 workflow 生成并上传，不入版本库）
docs/

# 日志
logs/
*.log

# 本地环境变量（含密钥，绝不入版本库）
.env

# OS
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp
*.swo
