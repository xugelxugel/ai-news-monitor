# ============================================================
# 每日AI资讯简报 · 云端运行环境变量模板
# 复制为 .env（本地调试）或在 GitHub Actions 中配置为 Secrets
# ============================================================

# ---- LLM 主供应商（智谱 GLM-4-Flash，免费）----
# 注册：https://open.bigmodel.cn  创建 API Key 后填入
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4-flash

# ---- LLM 备用供应商（Google Gemini 免费档）----
# 免费 Key 获取：https://aistudio.google.com/apikey
# 不配置则不启用回退（主供应商故障时任务会失败）
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_MODEL=gemini-3.6-flash

# ---- 微信提醒（Server酱 或 PushPlus，免费）----
# Server酱：sct.ftqq.com 用微信扫码登录 → 获取 SENDKEY（普通用户每天约 5 条）
# PushPlus：pushplus.plus 用微信扫码登录 → 获取 token（每天约 200 条）
# 本任务每天 1-2 条（简报提醒 + 失败通知），免费额度绰绰有余
WECHAT_NOTIFY_TYPE=serverchan   # serverchan | pushplus
WECHAT_NOTIFY_KEY=

# ---- 可选调优 ----
# LLM_CONCURRENCY=1
# LLM_TIMEOUT=90
